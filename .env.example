# This file contains environment variables for the FarmClub application. Copy this file to .env and fill in the values.

# ZeptoMail Send Mail Token — server-side secret; never commit the real token
ZEPTOMAIL_TOKEN=your_zeptomail_token_here

# Verified FarmClub OS sender address
CONTACT_FROM_EMAIL=hello@farmclubos.com

# Email address that receives contact-form submissions
CONTACT_TO_EMAIL=hello@farmclubos.com

# Email address that receives newsletter signup notifications (uses the same
# ZEPTOMAIL_TOKEN and CONTACT_FROM_EMAIL as the contact form above)
NEWSLETTER_TO_EMAIL=subscribers@farmclubos.com
